# Runtime
NODE_ENV=development
PORT=3000

# Prisma / SQLite
DATABASE_URL=file:./db/custom.db

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_SESSION_MAX_AGE_SECONDS=43200

# Demo account provisioning
DEMO_PASSWORD=dealflow360
NEXT_PUBLIC_DEMO_PASSWORD=dealflow360

# AI explainability defaults. AI is optional and never authoritative.
AI_ENABLED=true
AI_DEFAULT_TEMPERATURE=0.4
AI_DEFAULT_MAX_TOKENS=800
AI_RISK_TEMPERATURE=0.3
AI_RISK_MAX_TOKENS=500
AI_SUMMARY_TEMPERATURE=0.4
AI_SUMMARY_MAX_TOKENS=500
AI_TALKING_POINTS_TEMPERATURE=0.6
AI_TALKING_POINTS_MAX_TOKENS=600
